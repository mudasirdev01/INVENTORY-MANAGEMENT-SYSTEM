# Copy this file to .env.docker and replace every placeholder before starting Docker.

POSTGRES_DB=stockwise
POSTGRES_USER=stockwise_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set True only when HTTPS is terminated by a reverse proxy/load balancer.
SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

FRONTEND_PORT=8080
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
